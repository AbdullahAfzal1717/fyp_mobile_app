{
  "expo": {
    "name": "VitalSync",
    "slug": "vitalsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {},
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.vitalsync",
      "adaptiveIcon": {}
    },
    "web": {},
    "extra": {
      "apiBaseUrl": "http://localhost:5000",
      "socketUrl": "http://localhost:5000"
    },
    "plugins": ["@react-native-google-signin/google-signin"]
  }
}
